{
  "widgets": [
    {
      "type": "metric", "x": 0, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda Invocations",
        "metrics": [
          ["AWS/Lambda", "Invocations", "FunctionName", "url-auth"],
          ["AWS/Lambda", "Invocations", "FunctionName", "url-shorten"],
          ["AWS/Lambda", "Invocations", "FunctionName", "url-redirect"],
          ["AWS/Lambda", "Invocations", "FunctionName", "url-analytics"]
        ],
        "period": 60, "stat": "Sum", "region": "ap-south-1", "view": "timeSeries"
      }
    },
    {
      "type": "metric", "x": 12, "y": 0, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda Duration p95 (ms)",
        "metrics": [
          ["AWS/Lambda", "Duration", "FunctionName", "url-redirect", {"stat": "p95"}],
          ["AWS/Lambda", "Duration", "FunctionName", "url-shorten", {"stat": "p95"}],
          ["AWS/Lambda", "Duration", "FunctionName", "url-auth", {"stat": "p95"}]
        ],
        "period": 60, "region": "ap-south-1", "view": "timeSeries"
      }
    },
    {
      "type": "metric", "x": 0, "y": 6, "width": 8, "height": 6,
      "properties": {
        "title": "Lambda Errors",
        "metrics": [
          ["AWS/Lambda", "Errors", "FunctionName", "url-auth"],
          ["AWS/Lambda", "Errors", "FunctionName", "url-shorten"],
          ["AWS/Lambda", "Errors", "FunctionName", "url-redirect"]
        ],
        "period": 60, "stat": "Sum", "region": "ap-south-1", "view": "timeSeries"
      }
    },
    {
      "type": "metric", "x": 8, "y": 6, "width": 8, "height": 6,
      "properties": {
        "title": "DynamoDB Consumed RCU+WCU",
        "metrics": [
          ["AWS/DynamoDB", "ConsumedReadCapacityUnits", "TableName", "url-shard-a", {"stat": "Sum"}],
          ["AWS/DynamoDB", "ConsumedReadCapacityUnits", "TableName", "url-shard-b", {"stat": "Sum"}],
          ["AWS/DynamoDB", "ConsumedReadCapacityUnits", "TableName", "url-shard-c", {"stat": "Sum"}],
          ["AWS/DynamoDB", "ConsumedWriteCapacityUnits", "TableName", "url-shard-a", {"stat": "Sum"}],
          ["AWS/DynamoDB", "ConsumedWriteCapacityUnits", "TableName", "url-shard-b", {"stat": "Sum"}],
          ["AWS/DynamoDB", "ConsumedWriteCapacityUnits", "TableName", "url-shard-c", {"stat": "Sum"}]
        ],
        "period": 60, "region": "ap-south-1", "view": "timeSeries"
      }
    },
    {
      "type": "metric", "x": 16, "y": 6, "width": 8, "height": 6,
      "properties": {
        "title": "ElastiCache Redis Connections",
        "metrics": [
          ["AWS/ElastiCache", "CurrConnections", "CacheClusterId", "url-shortner-redis"],
          ["AWS/ElastiCache", "CacheHits", "CacheClusterId", "url-shortner-redis"],
          ["AWS/ElastiCache", "CacheMisses", "CacheClusterId", "url-shortner-redis"]
        ],
        "period": 60, "stat": "Average", "region": "ap-south-1", "view": "timeSeries"
      }
    },
    {
      "type": "metric", "x": 0, "y": 12, "width": 12, "height": 6,
      "properties": {
        "title": "SQS Analytics Queue Depth",
        "metrics": [
          ["AWS/SQS", "ApproximateNumberOfMessagesVisible", "QueueName", "url-analytics-queue"],
          ["AWS/SQS", "NumberOfMessagesSent", "QueueName", "url-analytics-queue"],
          ["AWS/SQS", "NumberOfMessagesDeleted", "QueueName", "url-analytics-queue"]
        ],
        "period": 60, "stat": "Sum", "region": "ap-south-1", "view": "timeSeries"
      }
    },
    {
      "type": "metric", "x": 12, "y": 12, "width": 12, "height": 6,
      "properties": {
        "title": "Lambda Throttles + Cold Starts",
        "metrics": [
          ["AWS/Lambda", "Throttles", "FunctionName", "url-redirect", {"stat": "Sum"}],
          ["AWS/Lambda", "Throttles", "FunctionName", "url-shorten", {"stat": "Sum"}],
          ["AWS/Lambda", "InitDuration", "FunctionName", "url-redirect", {"stat": "p95"}],
          ["AWS/Lambda", "InitDuration", "FunctionName", "url-shorten", {"stat": "p95"}]
        ],
        "period": 60, "region": "ap-south-1", "view": "timeSeries"
      }
    }
  ]
